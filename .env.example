# Copy to .env. Everything here has a working default — the stack comes up with
# no secrets at all, running fully locally on Ollama + local embeddings.

# ─── Model provider ──────────────────────────────────────────────────────────
# ollama (default, no key) | anthropic | openai | echo (deterministic stub)
LLM_PROVIDER=ollama

# Local model. Must be pulled first:  ollama pull qwen2.5:3b-instruct
#
# 3b is the default because it runs comfortably on a 8GB laptop with no GPU
# (~2GB resident) and still supports tool calling. On a machine with 16GB+ or a
# GPU, qwen2.5:7b-instruct gives noticeably better citation discipline — the
# routing layer exists partly to compensate for what small models get wrong.
# Other tool-calling options: llama3.1:8b, mistral-nemo, llama3.2:3b
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT_S=120

# Optional. Only needed if LLM_PROVIDER=anthropic (or as a fallback target).
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# What to do when the active provider is unreachable: none | ollama | anthropic | openai
# Left as `none` by default so a broken local setup fails loudly instead of
# silently spending money on a cloud key.
FALLBACK_PROVIDER=none

# Route the agent loop through claude-agent-sdk. Requires LLM_PROVIDER=anthropic
# and pip install -r requirements-agentsdk.txt. See architecture.md.
USE_AGENT_SDK=false

# ─── Storage ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://lenny:lenny@db:5432/lenny
# pgvector (deployment) | memory (tests, eval, laptop with no Postgres)
VECTOR_BACKEND=pgvector

# ─── Retrieval ───────────────────────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=30
CHUNK_TARGET_CHARS=1400

# ─── Grounding gate ──────────────────────────────────────────────────────────
FAITHFULNESS_ENABLED=true
# Calibrated in backend/eval/REPORT.md. Raise for fewer false "supported"
# labels at the cost of more amber underlines.
FAITHFULNESS_SUPPORTED_AT=0.65
FAITHFULNESS_PARTIAL_AT=0.45

# ─── Ops ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
